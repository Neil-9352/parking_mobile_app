{
  "expo": {
    "name": "iParking",
    "slug": "parking-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "parkeasy",
    "splash": {
      "backgroundColor": "#1a73e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.parkingfrontend"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a73e8"
      },
      "package": "com.anonymous.parkingfrontend"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "af24e807-ae6e-4bde-b6b1-8cf5b0003b42"
      }
    }
  }
}
